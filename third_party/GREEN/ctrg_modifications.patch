+class GreenSingle(GREEN):
+    """
+    无分布式版 GREEN
+    用法：
+        scorer = GreenSingle(model_name="...", gpu_id=0)   # 只用第 0 张卡
+        scores = scorer(refs, hyps)
+    """
+    def __init__(self, model_name=None, output_dir=".", cpu=False,
+                 compute_summary_stats=True, gpu_id=0):
+        # 先屏蔽掉父类里所有 dist 初始化
+        self._skip_dist = True
+        super().__init__(model_name=None, output_dir=output_dir, cpu=cpu,
+                         compute_summary_stats=compute_summary_stats)
+
+        # 下面重新加载模型（单卡）
+        if model_name and not cpu:
+            self.gpu_id = gpu_id
+            torch.cuda.set_device(gpu_id)
+            device = torch.device(f"cuda:{gpu_id}")
+
+            # 普通单卡加载：去掉 device_map
+            self.model = self._load_model_single(model_name, device)
+            self.tokenizer = self._load_tokenizer_single(model_name)
+
+            self.model_name = model_name.split("/")[-1]
+            self.model.eval()
+
+    # ---------- 工具：单卡加载 ----------
+    def _load_model_single(self, model_name, device):
+        from transformers import AutoModelForCausalLM
+        model = AutoModelForCausalLM.from_pretrained(
+            model_name,
+            trust_remote_code=False if "Phi" in model_name else True,
+            torch_dtype=torch.float16,
+        )
+        return model.to(device)
+
+    def _load_tokenizer_single(self, model_name):
+        from transformers import AutoTokenizer
+        tok = AutoTokenizer.from_pretrained(
+            model_name,
+            add_eos_token=True,
+            use_fast=True,
+            trust_remote_code=True,
+            padding_side="left",
+        )
+        chat_template = (
+            "{% for message in messages %}\n{% if message['from'] == 'human' %}"
+            "{{ '<|user|>\\n' + message['value'] + eos_token }}"
+            "{% elif message['from'] == 'gpt' %}"
+            "{{ '<|assistant|>\\n'  + message['value'] + eos_token }}"
+            "{% endif %}\n{% if loop.last and add_generation_prompt %}"
+            "{{ '<|assistant|>' }}"
+            "{% endif %}\n{% endfor %}"
+        )
+        tok.chat_template = chat_template
+        tok.pad_token = tok.eos_token
+        tok.clean_up_tokenization_spaces = True
+        return tok
+
+    # ---------- 覆盖父类 dist 相关方法 ----------
+    def __call__(self, refs, hyps):
+        # 彻底去掉 dist 分支
+        dataset = self.process_data(
+            Dataset.from_dict({"reference": refs, "prediction": hyps})
+        )
+        self.dataset = dataset
+        return self.infer()
+
+    @torch.inference_mode()
+    def infer(self):
+        assert self.model is not None and self.tokenizer is not None
+        # 不再 split_dataset_by_node，直接全量推理
+        self.completions, self.prompts = [], []
+        for batch in self.dataset.iter(batch_size=self.batch_size):
+            self.prompts.extend(batch["prompt"])
+            self.completions.extend(self.get_response(batch))
+        return self.process_results()
+
+    # 让 tokenize 落到当前卡
+    def tokenize_batch_as_chat(self, batch):
+        device = torch.device(f"cuda:{self.gpu_id}" if not self.cpu else "cpu")
+        batch = [
+            self.tokenizer.apply_chat_template(
+                i, tokenize=False, add_generation_prompt=True
+            )
+            for i in batch
+        ]
+        return self.tokenizer.batch_encode_plus(
+            batch,
+            return_tensors="pt",
+            padding=True,
+            truncation=True,
+            max_length=self.max_length,
+        ).to(device)
+
 
 
